datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailProvider {
  GOOGLE
  OUTLOOK
  SMTP
}

model User {
  id               String            @id @default(cuid())
  googleId         String?           @unique
  email            String            @unique
  name             String?
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  emails           Email[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id           String        @id @default(cuid())
  userId       String
  email        String
  name         String?
  provider     EmailProvider @default(GOOGLE)
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
  @@index([userId])
  @@map("senders")
}

model Email {
  id          String      @id @default(cuid())
  recipient   String
  subject     String
  body        String
  status      EmailStatus @default(SCHEDULED)
  scheduledAt DateTime
  sentAt      DateTime?
  error       String?
  bullJobId   String?
  previewUrl  String?
  userId      String?
  senderId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@index([userId])
  @@index([senderId])
  @@map("emails")
}

model SlackConnection {
  id                 String   @id @default(cuid())
  userId             String
  teamId             String
  teamName           String?
  botUserId          String?
  accessToken        String
  channelId          String?
  channelName        String?
  incomingWebhookUrl String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@map("slack_connections")
}
