# ==============================================================================
# ReachInbox Email Job Scheduler - Environment Configuration Template
# Copy this file to .env and provide your production or local development values.
# NEVER commit .env or any secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_scheduler?schema=public

# Optional parameters for local docker-compose
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_scheduler
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis & BullMQ Queue Broker
# ------------------------------------------------------------------------------
# Support either a full connection URL or discrete host/port/password
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
EMAIL_QUEUE_NAME=email-scheduling-queue

# ------------------------------------------------------------------------------
# 4. Elasticsearch Engine (Search & Indexing)
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Ethereal SMTP Provider (Email Delivery)
# ------------------------------------------------------------------------------
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM_EMAIL="ReachInbox Scheduler <scheduler@reachinbox.ai>"

# ------------------------------------------------------------------------------
# 6. Worker & Distributed Rate Limiting
# ------------------------------------------------------------------------------
# Set RUN_WORKER=false on API web instances when deploying Worker as a separate service
RUN_WORKER=true
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. Session Security & Bull Board Admin
# ------------------------------------------------------------------------------
SESSION_SECRET=reachinbox-production-session-secret-change-me-to-at-least-32-chars
ADMIN_SECRET=reachinbox-bull-board-admin-secret-token

# ------------------------------------------------------------------------------
# 8. Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 9. Slack OAuth 2.0 & Rate Limit Alert Webhook
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# ------------------------------------------------------------------------------
# 10. Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
